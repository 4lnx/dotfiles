# ==========================================================
# PORTABLE ZSHRC (macOS + Linux) — XDG + Stow Friendly
# ==========================================================

# ----------------------------------------------------------
# 1. OH MY ZSH
# ----------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="apple"

plugins=(
  z
  git
  brew
  podman
  gh
  kubectl
  helm
  terraform
  gcloud
  asdf
  node
  ansible
)

# ----------------------------------------------------------
# 2. XDG STANDARDS (fallback if not from .zprofile)
# ----------------------------------------------------------
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# ----------------------------------------------------------
# 3. OS DETECTION
# ----------------------------------------------------------
if [[ "$(uname)" == "Darwin" ]]; then
  OS_TYPE="macos"
else
  OS_TYPE="linux"
fi

# ----------------------------------------------------------
# 4. PATHS AND FPATHS (BEFORE OMZ)
# ----------------------------------------------------------

# ASDF
export ASDF_DATA_DIR="${ASDF_DATA_DIR:-$HOME/.asdf}"
export PATH="$ASDF_DATA_DIR/shims:$PATH"
fpath=("$ASDF_DATA_DIR/completions" $fpath)

# User local binaries
export PATH="$HOME/.local/bin:$PATH"

# Homebrew (macOS)
if [[ "$OS_TYPE" == "macos" ]]; then
  export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"

  # LibPQ
  if [[ -d "/opt/homebrew/opt/libpq/bin" ]]; then
    export PATH="/opt/homebrew/opt/libpq/bin:$PATH"
  fi
fi

# Antigravity
if [[ -d "$HOME/.antigravity/antigravity/bin" ]]; then
  export PATH="$HOME/.antigravity/antigravity/bin:$PATH"
fi

# LM Studio
if [[ -d "$HOME/.lmstudio/bin" ]]; then
  export PATH="$HOME/.lmstudio/bin:$PATH"
fi

# ----------------------------------------------------------
# 5. LOAD OH MY ZSH
# ----------------------------------------------------------
source "$ZSH/oh-my-zsh.sh"

# ----------------------------------------------------------
# 6. LANGUAGE / EDITOR
# ----------------------------------------------------------
export LANG="en_US.UTF-8"
export LC_CTYPE="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

# Preferred editor
if command -v nvim >/dev/null; then
  export EDITOR="$(command -v nvim)"
fi

# ----------------------------------------------------------
# 7. SSH AGENT (macOS)
# ----------------------------------------------------------
if [[ "$OS_TYPE" == "macos" ]]; then
  ssh-add --apple-load-keychain 2>/dev/null
fi

# ----------------------------------------------------------
# 8. ALIASES
# ----------------------------------------------------------

# Neovim
alias nv='nvim'
alias nvz='nvim ~/.zshrc'

# ASDF
alias qwe='asdf'

# Listing
alias l='eza -l --icons --git -a'

# Podman
alias pd='podman'
alias pdp='podman ps'
alias pdb='podman compose build'
alias pdu='podman compose up -d'
alias pdd='podman compose down'
alias pdl='podman logs -f'

# Certificate Authority Manager
alias cam='certificate-authority-manager'

# ----------------------------------------------------------
# 9. SDKs / INTEGRATIONS
# ----------------------------------------------------------

# Google Cloud SDK
if [[ -d "$HOME/.google-cloud-sdk" ]]; then
  [[ -f "$HOME/.google-cloud-sdk/path.zsh.inc" ]] && source "$HOME/.google-cloud-sdk/path.zsh.inc"
  [[ -f "$HOME/.google-cloud-sdk/completion.zsh.inc" ]] && source "$HOME/.google-cloud-sdk/completion.zsh.inc"
fi

# ----------------------------------------------------------
# 10. STARSHIP PROMPT
# ----------------------------------------------------------
export STARSHIP_CONFIG="$XDG_CONFIG_HOME/starship/starship.toml"

if command -v starship >/dev/null; then
  eval "$(starship init zsh)"
fi

# ----------------------------------------------------------
# 11. MISE IN PLACE
# ----------------------------------------------------------
eval "$(mise activate zsh)"


# ----------------------------------------------------------
# 12. LM STUDIO
# ----------------------------------------------------------
export PATH="$PATH:$HOME/.lmstudio/bin"


# Added by LM Studio CLI (lms)
export PATH="$PATH:/Users/4lnx/.lmstudio/bin"
# End of LM Studio CLI section

