# ==========================================================
# PORTABLE ZSHRC (macOS + Linux) — XDG + Stow Friendly
# ==========================================================

# ----------------------------------------------------------
# OH MY ZSH
# ----------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="apple"

plugins=(
  z
  git
  brew
  podman
  gh
  kubectl
  helm
  terraform
  gcloud
  asdf
  node
  ansible
)

# ----------------------------------------------------------
# XDG STANDARDS (fallback if not from .zprofile)
# ----------------------------------------------------------
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# ----------------------------------------------------------
# OS DETECTION
# ----------------------------------------------------------
if [[ "$(uname)" == "Darwin" ]]; then
  OS_TYPE="macos"
else
  OS_TYPE="linux"
fi

# ----------------------------------------------------------
# PATHS AND FPATHS (BEFORE OMZ)
# ----------------------------------------------------------

# User local binaries
export PATH="$HOME/.local/bin:$PATH"

# Homebrew (macOS)
if [[ "$OS_TYPE" == "macos" ]]; then
  export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"

  # LibPQ
  if [[ -d "/opt/homebrew/opt/libpq/bin" ]]; then
    export PATH="/opt/homebrew/opt/libpq/bin:$PATH"
  fi
fi

# ----------------------------------------------------------
# LOAD OH MY ZSH
# ----------------------------------------------------------
source "$ZSH/oh-my-zsh.sh"

# ----------------------------------------------------------
# LANGUAGE / EDITOR (macOS)
# ----------------------------------------------------------
if [[ "$OS_TYPE" == "macos" ]]; then
    export LANG="pt_BR.UTF-8"
    export LC_CTYPE="pt_BR.UTF-8"
    export LC_ALL="pt_BR.UTF-8"
fi

# Preferred editor
if command -v nvim >/dev/null; then
  export EDITOR="$(command -v nvim)"
fi

# ----------------------------------------------------------
# SSH AGENT (macOS)
# ----------------------------------------------------------
if [[ "$OS_TYPE" == "macos" ]]; then
  ssh-add --apple-load-keychain 2>/dev/null
fi

# ----------------------------------------------------------
# ALIASES
# ----------------------------------------------------------

# Neovim
alias nv='nvim'
alias nvz='nvim ~/.zshrc'

# Listing
alias l='eza -l --icons --git'

# Podman
alias pd='podman'
alias pdp='podman ps'
alias pdb='podman compose build'
alias pdu='podman compose up -d'
alias pdd='podman compose down'
alias pdl='podman logs -f'


# ----------------------------------------------------------
# SDKs / INTEGRATIONS
# ----------------------------------------------------------

# ----------------------------------------------------------
# STARSHIP PROMPT
# ----------------------------------------------------------
export STARSHIP_CONFIG="$XDG_CONFIG_HOME/starship/starship.toml"

if command -v starship >/dev/null; then
  eval "$(starship init zsh)"
fi

# ----------------------------------------------------------
#  MISE IN PLACE
# ----------------------------------------------------------
eval "$(mise activate zsh)"
